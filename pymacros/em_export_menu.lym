<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>EM Export menu (Tools &gt; EM Export)</description>
 <version/>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>import pya
if pya.Application.instance().main_window() is not None:     # not in batch mode
    from klayout_em_export.gui import install_menu
    install_menu()
</text>
</klayout-macro>
